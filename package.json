{
  "name": "younesh",
  "version": "1.6.0",
  "description": "Terminal pour Windows avec les discussions rangées dans des dossiers de couleur",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "author": "Y",
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.jonasmelheb.younesh",
    "productName": "Younesh",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "!node_modules/@xterm/*/src/**",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "jonasmelheb",
        "repo": "younesh"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Younesh-Setup-${version}.${ext}",
      "shortcutName": "Younesh"
    },
    "portable": {
      "artifactName": "Younesh-Portable-${version}.${ext}"
    },
    "msi": {
      "artifactName": "Younesh-${version}.${ext}",
      "perMachine": false,
      "shortcutName": "Younesh",
      "createDesktopShortcut": true
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum"
  }
}
